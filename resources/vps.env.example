# HS React — VPS Environment Variables
# Copy this to /headscale/.env and fill in your values
# NEVER commit the actual .env file to GitHub

# JWT secret for session tokens — generate with: openssl rand -base64 32
JWT_SECRET=your-random-jwt-secret-here

# Headscale internal Docker URL
HEADSCALE_URL=http://headscale:8080

# License key validation secret — generate with: openssl rand -base64 32
# Must match the secret used in your key generator script
HS_LICENSE_SECRET=your-random-license-secret-here
