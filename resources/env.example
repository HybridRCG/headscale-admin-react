# HS React - Environment Variables
# Copy this to .env and fill in your values

# REQUIRED: Random secret for JWT session tokens
# Generate with: openssl rand -base64 32
JWT_SECRET=your-random-secret-here

# REQUIRED: Your headscale domain
HEADSCALE_DOMAIN=your-headscale-domain.com

# Optional: Headscale internal URL (default works if in same Docker network)
HEADSCALE_URL=http://headscale:8080
