# Headscale Admin React - Environment Variables
# Copy this file to .env and fill in your values

# JWT secret for session tokens - generate with: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-here

# Headscale server URL (internal Docker network name or external URL)
HEADSCALE_URL=http://headscale:8080

# Public URL path (must match your reverse proxy config)
PUBLIC_URL=/admin

# API base path
REACT_APP_API_URL=/admin/api
